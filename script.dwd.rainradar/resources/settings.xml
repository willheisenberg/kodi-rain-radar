<?xml version="1.0" encoding="utf-8"?>
<!-- Labels sind IDs aus resources/language/*/strings.po; Klartext zeigt Kodi hier nicht an. -->
<settings version="1">
  <section id="script.dwd.rainradar">
    <category id="standort" label="32000">
      <group id="1">
        <setting id="location_mode" type="integer" label="32001" help="32002">
          <level>0</level>
          <default>0</default>
          <constraints>
            <options>
              <option label="32003">0</option>
              <option label="32004">1</option>
              <option label="32005">2</option>
            </options>
          </constraints>
          <control type="spinner" format="string"/>
        </setting>
        <setting id="latitude" type="number" label="32006" parent="location_mode">
          <level>0</level>
          <default>52.52</default>
          <constraints><minimum>45</minimum><maximum>57</maximum></constraints>
          <dependencies>
            <dependency type="visible" setting="location_mode">1</dependency>
          </dependencies>
          <control type="edit" format="number"/>
        </setting>
        <setting id="longitude" type="number" label="32007" parent="location_mode">
          <level>0</level>
          <default>13.40</default>
          <constraints><minimum>2</minimum><maximum>19</maximum></constraints>
          <dependencies>
            <dependency type="visible" setting="location_mode">1</dependency>
          </dependencies>
          <control type="edit" format="number"/>
        </setting>
      </group>
    </category>
    <category id="ansicht" label="32010">
      <group id="1">
        <setting id="start_zoom" type="integer" label="32011" help="32012">
          <level>0</level>
          <default>0</default>
          <constraints><minimum>0</minimum><step>1</step><maximum>4</maximum></constraints>
          <control type="slider" format="integer"/>
        </setting>
        <setting id="opacity" type="integer" label="32013">
          <level>0</level>
          <default>80</default>
          <constraints><minimum>30</minimum><step>5</step><maximum>100</maximum></constraints>
          <control type="slider" format="percentage"/>
        </setting>
      </group>
    </category>
    <category id="animation" label="32020">
      <group id="1">
        <setting id="past_hours" type="integer" label="32021">
          <level>0</level>
          <default>2</default>
          <constraints><minimum>1</minimum><step>1</step><maximum>3</maximum></constraints>
          <control type="slider" format="integer"/>
        </setting>
        <setting id="forecast" type="boolean" label="32022">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
        <setting id="frame_ms" type="integer" label="32023">
          <level>0</level>
          <default>400</default>
          <constraints><minimum>100</minimum><step>50</step><maximum>1500</maximum></constraints>
          <control type="slider" format="integer"/>
        </setting>
        <setting id="autoplay" type="boolean" label="32024">
          <level>0</level>
          <default>true</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
