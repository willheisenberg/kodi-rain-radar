# Kodi Media Center language file
# Addon id: script.dwd.rainradar
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: de_DE\n"

msgctxt "#32000"
msgid "Location"
msgstr "Standort"

msgctxt "#32001"
msgid "Determine location"
msgstr "Standort ermitteln"

msgctxt "#32002"
msgid "The location is marked on the map; zooming in centres on it. Automatic uses your public IP address (city level)."
msgstr "Der Standort wird auf der Karte markiert, beim Hineinzoomen wird auf ihn zentriert. Automatisch nutzt die öffentliche IP-Adresse (ungefähr auf Stadtebene)."

msgctxt "#32003"
msgid "Automatic (IP address)"
msgstr "Automatisch (IP-Adresse)"

msgctxt "#32004"
msgid "Manual (coordinates)"
msgstr "Manuell (Koordinaten)"

msgctxt "#32005"
msgid "Off"
msgstr "Aus"

msgctxt "#32006"
msgid "Latitude (e.g. 52.52)"
msgstr "Breitengrad (z. B. 52.52)"

msgctxt "#32007"
msgid "Longitude (e.g. 13.40)"
msgstr "Längengrad (z. B. 13.40)"

msgctxt "#32010"
msgid "View"
msgstr "Ansicht"

msgctxt "#32011"
msgid "Zoom level at start"
msgstr "Zoomstufe beim Start"

msgctxt "#32012"
msgid "0 = whole Germany, 1–4 = increasingly close around your location."
msgstr "0 = ganz Deutschland, 1–4 = immer näher um den Standort."

msgctxt "#32013"
msgid "Radar opacity"
msgstr "Deckkraft des Radars"

msgctxt "#32020"
msgid "Animation"
msgstr "Animation"

msgctxt "#32021"
msgid "History (hours)"
msgstr "Verlauf (Stunden)"

msgctxt "#32022"
msgid "Show forecast (2 hours)"
msgstr "Vorhersage anzeigen (2 Stunden)"

msgctxt "#32023"
msgid "Duration per frame (ms)"
msgstr "Anzeigedauer pro Bild (ms)"

msgctxt "#32024"
msgid "Start animation automatically"
msgstr "Animation automatisch starten"
